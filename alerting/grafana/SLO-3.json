{
  "folder": "SLO",
  "slo": "SLO-3",
  "build_status": "needs-probe",
  "needs_probe": true,
  "rules": [
    {
      "uid": "slo-3-latency",
      "title": "SLO-3 Gateway latency \u2014 p95 latency (P1)",
      "condition": "COND",
      "data": [
        {
          "refId": "P95",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "Prometheus",
          "model": {
            "refId": "P95",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"ms-gateway-api\"}[5m])) by (le)) * 1000",
            "instant": true
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "max",
            "expression": "P95"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    800
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "labels": {
        "slo": "SLO-3",
        "severity": "P1",
        "owner": "Admin",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-3 Gateway latency: p95 > 800ms sustained 10m.",
        "owner_team": "Admin",
        "slo": "SLO-3",
        "journey": "Gateway latency",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-3"
      },
      "ruleGroup": "slo-3-latency",
      "isPaused": false
    }
  ]
}
