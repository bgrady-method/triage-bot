      {
        "id": 2,
        "title": "Screen RTC \u2014 mean latency (ms)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 12,
          "h": 8
        },
        "datasource": {
          "type": "influxdb",
          "uid": "rtcapi_metrics"
        },
        "targets": [
          {
            "datasource": {
              "type": "influxdb",
              "uid": "rtcapi_metrics"
            },
            "query": "SELECT mean(\"mean\") FROM \"rtcapi_request\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
            "rawQuery": true,
            "resultFormat": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {}
      },
      {
        "id": 3,
        "title": "Screen RTC \u2014 5xx count",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 3,
          "w": 12,
          "h": 8
        },
        "datasource": {
          "type": "influxdb",
          "uid": "rtcapi_metrics"
        },
        "targets": [
          {
            "datasource": {
              "type": "influxdb",
              "uid": "rtcapi_metrics"
            },
            "query": "SELECT sum(\"count\") FROM \"rtcapi_request\" WHERE \"response_code\" =~ /^5/ AND $timeFilter GROUP BY time($__interval) fill(0)",
            "rawQuery": true,
            "resultFormat": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {}
      },
