{
  "folder": "SLO",
  "slo": "SLO-4",
  "build_status": "buildable-now",
  "needs_probe": true,
  "rules": [
    {
      "uid": "slo-4-latency",
      "title": "SLO-4 Screen runtime load \u2014 p95 latency (P1)",
      "condition": "COND",
      "data": [
        {
          "refId": "P95",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "P95",
            "query": "SELECT percentile(\"duration_ms\", 95) FROM \"rtc_request\" WHERE \"endpoint\" =~ /screen|datatable/ AND $timeFilter GROUP BY time(1m)",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "max",
            "expression": "P95"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    3000
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "labels": {
        "slo": "SLO-4",
        "severity": "P1",
        "owner": "Vertical App Experience",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-4 Screen runtime load: p95 > 3000ms sustained 10m.",
        "owner_team": "Vertical App Experience",
        "slo": "SLO-4",
        "journey": "Screen runtime load",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-4"
      },
      "ruleGroup": "slo-4-latency",
      "isPaused": false
    },
    {
      "uid": "slo-4-fast",
