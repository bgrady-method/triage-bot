        {
          "refId": "EL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "EL",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_L"
          }
        },
        {
          "refId": "TL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TL",
            "type": "reduce",
            "reducer": "last",
