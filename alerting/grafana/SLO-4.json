{
  "folder": "Triage Bot / SLO",
  "slo": "SLO-4",
  "build_status": "buildable-now",
  "rules": [
    {
      "uid": "slo-4-errors-fast",
      "title": "SLO-4 Screen runtime load \u2014 error burn fast (P1)",
      "condition": "BURN",
      "data": [
        {
          "refId": "ERR_L",
          "relativeTimeRange": {
            "from": 3600,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "ERR_L",
            "query": "SELECT sum(\"count\") FROM \"rtcapi_request\" WHERE (\"response_code\" =~ /^5/) AND $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "TOT_L",
          "relativeTimeRange": {
            "from": 3600,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "TOT_L",
            "query": "SELECT sum(\"count\") FROM \"rtcapi_request\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "EL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "EL",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_L"
          }
        },
        {
          "refId": "TL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TL",
            "type": "reduce",
            "reducer": "last",
            "expression": "TOT_L"
          }
        },
        {
          "refId": "ERR_S",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "ERR_S",
            "query": "SELECT sum(\"count\") FROM \"rtcapi_request\" WHERE (\"response_code\" =~ /^5/) AND $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "TOT_S",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "TOT_S",
            "query": "SELECT sum(\"count\") FROM \"rtcapi_request\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "ES",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "ES",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_S"
          }
        },
        {
          "refId": "TS",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TS",
            "type": "reduce",
            "reducer": "last",
            "expression": "TOT_S"
          }
        },
        {
          "refId": "BURN_RAW",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN_RAW",
            "type": "math",
            "expression": "(${EL}/(${TL}+1) > 0.0144) && (${ES}/(${TS}+1) > 0.0144)"
          }
        },
        {
          "refId": "BURN",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN",
            "type": "threshold",
            "expression": "BURN_RAW",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "labels": {
        "slo": "SLO-4",
        "severity": "P1",
        "owner": "Vertical App Experience",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-4 Screen runtime load: error budget burning >= 14.4x over 1h+5m (target 0.999, page).",
        "owner_team": "Vertical App Experience",
        "slo": "SLO-4",
        "journey": "Screen runtime load",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-4"
      },
      "ruleGroup": "slo-4-errors-fast",
      "isPaused": false,
      "notification_settings": {
        "receiver": "triage-bot-health",
        "group_by": [
          "alertname",
          "slo"
        ]
      }
    },
