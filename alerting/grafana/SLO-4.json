          }
        },
        {
          "refId": "ERR_S",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "applogs-es",
          "model": {
            "refId": "ERR_S",
            "query": "service:runtime-core AND tag:screen AND status:>=500",
            "alias": "",
            "metrics": [
              {
                "id": "1",
                "type": "count"
              }
            ],
            "bucketAggs": [],
            "timeField": "@timestamp"
          }
        },
        {
          "refId": "TOT_S",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "applogs-es",
          "model": {
            "refId": "TOT_S",
            "query": "service:runtime-core AND tag:screen",
            "alias": "",
            "metrics": [
              {
                "id": "1",
                "type": "count"
              }
            ],
            "bucketAggs": [],
            "timeField": "@timestamp"
          }
        },
        {
          "refId": "ES",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "ES",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_S"
          }
        },
        {
          "refId": "TS",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TS",
            "type": "reduce",
            "reducer": "last",
            "expression": "TOT_S"
          }
        },
        {
          "refId": "BURN_RAW",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN_RAW",
            "type": "math",
            "expression": "(${EL}/(${TL}+1) > 0.0144) && (${ES}/(${TS}+1) > 0.0144)"
          }
        },
        {
          "refId": "BURN",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN",
            "type": "threshold",
            "expression": "BURN_RAW",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "labels": {
        "slo": "SLO-4",
        "severity": "P1",
        "owner": "Vertical App Experience",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-4 Screen runtime load: error budget burning >= 14.4x over 1h+5m (target 0.999, page).",
        "owner_team": "Vertical App Experience",
        "slo": "SLO-4",
        "journey": "Screen runtime load",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-4"
      },
      "ruleGroup": "slo-4-fast",
      "isPaused": false
    },
