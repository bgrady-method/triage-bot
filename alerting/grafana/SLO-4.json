        "severity": "P2",
        "owner": "Vertical App Experience",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-4 Screen runtime load: error budget burning >= 3x over 24h+2h (target 0.999, ticket).",
        "owner_team": "Vertical App Experience",
        "slo": "SLO-4",
        "journey": "Screen runtime load",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-4"
      },
      "ruleGroup": "slo-4-errors-slow",
      "isPaused": false,
