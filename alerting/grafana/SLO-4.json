    },
    {
      "uid": "slo-4-latency",
      "title": "SLO-4 Screen runtime load \u2014 latency (P2)",
      "condition": "COND",
      "data": [
        {
          "refId": "LAT",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "rtcapi_metrics",
          "model": {
            "refId": "LAT",
            "query": "SELECT mean(\"mean\") FROM \"rtcapi_request\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "last",
            "expression": "LAT"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    1000
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "labels": {
        "slo": "SLO-4",
        "severity": "P2",
        "owner": "Vertical App Experience",
        "pager": "triage-bot"
