{
  "folder": "Triage Bot / SLO",
  "slo": "F2",
  "build_status": "buildable-now",
  "rules": [
    {
      "uid": "f2-dead-lettering",
      "title": "F2 RabbitMQ dead-lettering (P2)",
      "condition": "COND",
      "data": [
        {
          "refId": "D",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "InfluxDB",
          "model": {
            "refId": "D",
            "query": "SELECT non_negative_difference(max(\"messages_ready\")) FROM \"rabbitmq_queue\" WHERE \"queue\" =~ /_error$/ AND $timeFilter GROUP BY time(5m), \"queue\"",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "max",
            "expression": "D"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    50
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "15m",
      "labels": {
        "slo": "F2",
        "severity": "P2",
        "owner": "Connect",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "F2 RabbitMQ dead-lettering: a *_error queue grew by > 50 messages in 5m (active dead-lettering, not the static baselines).",
        "owner_team": "Connect",
        "slo": "F2",
        "journey": "RabbitMQ dead-lettering",
        "runbook": "references/architecture/alerting-system-design.md#rb-f2"
      },
      "ruleGroup": "f2-dead-lettering",
      "isPaused": false,
      "notification_settings": {
        "receiver": "triage-bot-health",
        "group_by": [
          "alertname",
          "slo"
        ]
      }
    }
  ]
}
