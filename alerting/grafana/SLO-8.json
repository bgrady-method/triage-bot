{
  "folder": "SLO",
  "slo": "SLO-8",
  "build_status": "needs-probe",
  "needs_probe": true,
  "rules": [
    {
      "uid": "subscriber-heartbeat",
      "title": "SLO-8 subscriber-heartbeat (P1)",
      "condition": "COND",
      "data": [
        {
          "refId": "HB",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "eda_metrics",
          "model": {
            "refId": "HB",
            "query": "SELECT count(\"value\") FROM \"subscriber_heartbeat\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "count",
            "expression": "HB"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "slo": "SLO-8",
        "severity": "P1",
        "owner": "CRM Experience",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "subscriber-heartbeat: no datapoints in 5m (heartbeat lost).",
        "owner_team": "CRM Experience",
        "slo": "SLO-8",
        "journey": "Cache-invalidation timeliness (Runtime.Core.Subscriber)",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-8"
      },
      "ruleGroup": "subscriber-heartbeat",
      "isPaused": false
    },
    {
      "uid": "rabbitmq-consumer-lag",
      "title": "SLO-8 rabbitmq-consumer-lag (P2)",
      "condition": "COND",
      "data": [
        {
          "refId": "V",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "eda_metrics",
          "model": {
            "refId": "V",
            "query": "SELECT max(\"messages\") FROM \"consumer_lag\" WHERE \"consumer\" =~ /runtime.core.subscriber/ AND $timeFilter GROUP BY time(1m)",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "R",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "R",
            "type": "reduce",
            "reducer": "max",
            "expression": "V"
          }
        },
        {
          "refId": "COND",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "COND",
            "type": "threshold",
            "expression": "R",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    100
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "slo": "SLO-8",
        "severity": "P2",
        "owner": "CRM Experience",
        "pager": "triage-bot",
        "inhibited_by": "subscriber-heartbeat"
      },
      "annotations": {
        "summary": "rabbitmq-consumer-lag: value > 100 sustained 5m.",
        "owner_team": "CRM Experience",
        "slo": "SLO-8",
        "journey": "Cache-invalidation timeliness (Runtime.Core.Subscriber)",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-8"
      },
      "ruleGroup": "rabbitmq-consumer-lag",
      "isPaused": false
    }
  ]
}
