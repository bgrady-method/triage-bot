{
  "folder": "Triage Bot / SLO",
  "slo": "SLO-7",
  "build_status": "buildable-now",
  "rules": [
    {
      "uid": "slo-7-errors-slow",
      "title": "SLO-7 QBO sync freshness \u2014 error burn slow (P2)",
      "condition": "BURN",
      "data": [
        {
          "refId": "ERR_L",
          "relativeTimeRange": {
            "from": 86400,
            "to": 0
          },
          "datasourceUid": "syncservice_metrics",
          "model": {
            "refId": "ERR_L",
            "query": "SELECT sum(\"count\") FROM \"syncservice_request\" WHERE (\"haserror\"='true') AND $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "TOT_L",
          "relativeTimeRange": {
            "from": 86400,
            "to": 0
          },
          "datasourceUid": "syncservice_metrics",
          "model": {
            "refId": "TOT_L",
            "query": "SELECT sum(\"count\") FROM \"syncservice_request\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "EL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "EL",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_L"
          }
        },
        {
          "refId": "TL",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TL",
            "type": "reduce",
            "reducer": "last",
            "expression": "TOT_L"
          }
        },
        {
          "refId": "ERR_S",
          "relativeTimeRange": {
            "from": 7200,
            "to": 0
          },
          "datasourceUid": "syncservice_metrics",
          "model": {
            "refId": "ERR_S",
            "query": "SELECT sum(\"count\") FROM \"syncservice_request\" WHERE (\"haserror\"='true') AND $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "TOT_S",
          "relativeTimeRange": {
            "from": 7200,
            "to": 0
          },
          "datasourceUid": "syncservice_metrics",
          "model": {
            "refId": "TOT_S",
            "query": "SELECT sum(\"count\") FROM \"syncservice_request\" WHERE $timeFilter",
            "rawQuery": true,
            "resultFormat": "time_series"
          }
        },
        {
          "refId": "ES",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "ES",
            "type": "reduce",
            "reducer": "last",
            "expression": "ERR_S"
          }
        },
        {
          "refId": "TS",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "TS",
            "type": "reduce",
            "reducer": "last",
            "expression": "TOT_S"
          }
        },
        {
          "refId": "BURN_RAW",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN_RAW",
            "type": "math",
            "expression": "(${EL}/(${TL}+1) > 0.03) && (${ES}/(${TS}+1) > 0.03)"
          }
        },
        {
          "refId": "BURN",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "BURN",
            "type": "threshold",
            "expression": "BURN_RAW",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "15m",
      "labels": {
        "slo": "SLO-7",
        "severity": "P2",
        "owner": "Connect",
        "pager": "triage-bot"
      },
      "annotations": {
        "summary": "SLO-7 QBO sync freshness: error budget burning >= 3x over 24h+2h (target 0.99, ticket).",
        "owner_team": "Connect",
        "slo": "SLO-7",
        "journey": "QBO sync freshness",
        "runbook": "references/architecture/alerting-system-design.md#rb-slo-7"
      },
      "ruleGroup": "slo-7-errors-slow",
      "isPaused": false,
      "notification_settings": {
        "receiver": "triage-bot-health",
        "group_by": [
          "alertname",
          "slo"
        ]
      }
    }
  ]
}
