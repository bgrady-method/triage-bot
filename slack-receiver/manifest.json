{
  "display_information": {
    "name": "triage-bot",
    "description": "Delivers Grafana alerts and posts triage-bot findings to Slack",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "triage-bot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "incoming-webhook",
        "chat:write",
        "im:write",
        "channels:history",
        "channels:read",
        "groups:history",
        "reactions:read",
        "users:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
