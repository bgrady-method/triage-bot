# Datadog API credentials for the dd-* skill family.
# Copy this file to `.env` in the same directory and fill in the values.
# DO NOT commit `.env` — it's in .gitignore.

# API Key — Datadog UI -> Organization Settings -> API Keys
# Identifies your organization. Has no scopes of its own.
DD_API_KEY=

# Application Key — Datadog UI -> Personal Settings -> Application Keys
# Authenticates as you. Required scopes for the dd-* skills:
#   logs_read_data    (used by dd-logs)
#   metrics_read      (used by dd-metrics)
#   monitors_read     (used by dd-monitors)
#   apm_read          (used by dd-apm)
# Create a new key with all four scopes, or edit an existing key to add them.
DD_APP_KEY=

# Datadog site (region). Default: datadoghq.com (US1).
# Other valid values: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com,
# ap1.datadoghq.com, ddog-gov.com.
# Look at the URL you use to log into Datadog — the host is your site.
DD_SITE=datadoghq.com
