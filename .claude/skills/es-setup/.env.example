# Elasticsearch / Kibana credentials for the es-* skill family.
# Copy this file to `.env` in the same directory and fill in the values.
# DO NOT commit `.env` — it's in .gitignore.

# Cluster search endpoint (no trailing slash). For Method's production Logstash cluster:
ES_SEARCH_ENDPOINT=https://ca8e80d7f930400fb386a29477353efa.us-west-1.aws.found.io:443

# Elastic Cloud ID (optional — only used by Elastic's official SDKs; the es-*
# scripts talk to ES_SEARCH_ENDPOINT directly over REST and don't need this.
# Leave it blank or populate from Elastic Cloud console if you already have it
# pasted in from another tool.
ES_CLOUD_ID=

# Basic auth — your Elastic / Kibana username and password.
# Prefer a service account over a personal login if you have one.
ES_USERNAME=
ES_PASSWORD=

# Default index pattern used when scripts don't specify one. Override per-call
# with --index. Common logstash pattern is `logstash-*`, but your deployment
# may use `logs-*`, `filebeat-*`, etc. Leave blank to force every invocation
# to pass --index explicitly.
ES_DEFAULT_INDEX=logstash-*

# Kibana web URL (no trailing slash). Used only to build clickable pivot
# links in script output. Defaults to Method's Logstash Kibana if unset.
KIBANA_URL=https://logstash.method.me
