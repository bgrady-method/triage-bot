{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(jq *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Read(*)",
      "Edit(kb/**)",
      "Edit(docs/**)",
      "Edit(stability-reviews/**)",
      "Edit(logs/**)",
      "Write(kb/**)",
      "Write(docs/**)",
      "Write(stability-reviews/**)",
      "Write(logs/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "mcp__slack__*",
      "mcp__github__*",
      "mcp__atlassian__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Read(.env)",
      "Edit(.env)",
      "Edit(routines/*.prompt.md)",
      "Edit(routines/*.yaml)",
      "Edit(.claude/**)",
      "Edit(.mcp.json)",
      "Edit(.gitignore)",
      "Edit(CLAUDE.md)",
      "Edit(prompt.md)",
      "Edit(stability-review-prompt.md)",
      "Edit(playbooks/**)",
      "Edit(scripts/**)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  }
}
